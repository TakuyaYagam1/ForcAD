ARG BASE_IMAGE=forcad_base:local

FROM ${BASE_IMAGE}

USER root

RUN apt-mark manual libpq5 \
    && apt-get purge -y --auto-remove gcc libc6-dev libpq-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall -y pip \
    && rm -rf /usr/local/lib/python3.11/ensurepip

COPY backend /app

COPY ./docker_config/initializer/entrypoint.sh /entrypoint.sh
COPY ./docker_config/initializer/stage_config.sh /stage_config.sh
RUN chmod +x /entrypoint.sh /stage_config.sh

USER forcad:forcad

CMD ["/entrypoint.sh"]
