map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_content_encoding $reject_api_content_encoding {
    default 1;
    "" 0;
    "~*^identity$" 0;
}

map $uri $team_logo_csp {
    default "";
    ~*\.svg$ "default-src 'none'; style-src 'unsafe-inline'; sandbox";
}

# Explicit same-host WebSocket sources cover browsers that do not map 'self'
# to ws/wss. Reflect only an ordinary Host authority, never arbitrary header text.
map $http_host $frontend_websocket_sources {
    default "";
    "~^[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?(?::[0-9]{1,5})?$" "ws://$http_host wss://$http_host";
    "~^\[[0-9a-fA-F:]+\](?::[0-9]{1,5})?$" "ws://$http_host wss://$http_host";
}

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=150r/s;

resolver ${DNS_RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

upstream api_backend {
    zone api_backend 64k;
    server api:5000 resolve;
    keepalive 32;
}

upstream receiver_backend {
    zone receiver_backend 64k;
    server receiver:5000 resolve;
    keepalive 32;
}

client_body_temp_path /tmp/nginx/client_temp;
proxy_temp_path /tmp/nginx/proxy_temp;
fastcgi_temp_path /tmp/nginx/fastcgi_temp;
uwsgi_temp_path /tmp/nginx/uwsgi_temp;
scgi_temp_path /tmp/nginx/scgi_temp;

client_max_body_size 64k;
client_body_timeout 10s;
client_header_timeout 10s;
client_header_buffer_size 1k;
large_client_header_buffers 2 8k;
send_timeout 30s;
keepalive_timeout 15s;
server_tokens off;

server {
    listen 8080;

    server_name default;

    include /tmp/forcad-trusted-proxies.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location = /api/client/metrics {
        return 404;
    }

    location = /api/admin/metrics {
        return 404;
    }

    location = /api/http-receiver/metrics {
        return 404;
    }

    location = /api/events/ws {
        proxy_pass http://api_backend;
        include proxy_params_ws;
        include /etc/nginx/api_limits.conf;
    }

    location /flags {
        proxy_pass http://receiver_backend;
        proxy_next_upstream off;
        include proxy_params;

        client_max_body_size 10K;
        include /etc/nginx/api_limits.conf;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=60 nodelay;
        limit_req_status 429;
        error_page 429 = @api_rate_limit;

        proxy_pass http://api_backend;
        include proxy_params;
        include /etc/nginx/api_limits.conf;
    }

    location @api_rate_limit {
        add_header Retry-After "2" always;
        return 429;
    }

    location ^~ /socket.io {
        return 404;
    }

    location ^~ /team-logos/ {
        alias /var/www/front/team-logos/;
        autoindex off;
        add_header Cache-Control no-cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy $team_logo_csp always;
    }

    location ^~ /teams/ {
        return 404;
    }

    location / {
        include /etc/nginx/frontend_security_headers.conf;
        gzip on;
        gzip_static on;
        gzip_types text/plain text/css text/javascript application/javascript;
        gzip_disable "msie6";
        root /var/www/front;
        try_files $uri /index.html;
        autoindex off;
    }
}
