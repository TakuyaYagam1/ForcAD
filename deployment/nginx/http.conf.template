map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_content_encoding $reject_api_content_encoding {
    default 1;
    "" 0;
    "~*^identity$" 0;
}

map $uri $team_logo_csp {
    default "";
    ~*\.svg$ "default-src 'none'; style-src 'unsafe-inline'; sandbox";
}

# Explicit same-host WebSocket sources cover browsers that do not map 'self'
# to ws/wss. Reflect only an ordinary Host authority, never arbitrary header text.
map $http_host $frontend_websocket_sources {
    default "";
    "~^[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?(?::[0-9]{1,5})?$" "ws://$http_host wss://$http_host";
    "~^\[[0-9a-fA-F:]+\](?::[0-9]{1,5})?$" "ws://$http_host wss://$http_host";
}

# Apply the admin ACL to the TCP peer, not to forwarded client addresses.
geo $realip_remote_addr $forcad_admin_peer {
    include /tmp/forcad-admin-network.conf;
}

geo $realip_remote_addr $forcad_admin_blocked_peer {
    default 0;
    include /tmp/forcad-admin-deny.conf;
}

map "$forcad_admin_peer:$forcad_admin_blocked_peer" $forcad_admin_peer_denied {
    default 1;
    1:0 0;
}

map $uri $forcad_admin_denied {
    default 0;
    ~*^/(api/v1/)?admin(/|$) $forcad_admin_peer_denied;
}

map $request_method $login_rate_ip {
    default "";
    POST $binary_remote_addr;
}

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=150r/s;
limit_req_zone $login_rate_ip zone=login_per_ip:1m rate=1r/s;
limit_req_zone $binary_remote_addr zone=flags_per_ip:10m rate=${FORCAD_FLAGS_IP_RPS}r/s;
limit_req_zone $server_name zone=flags_total:1m rate=${FORCAD_FLAGS_TOTAL_RPS}r/s;
limit_conn_zone $binary_remote_addr zone=board_ws_per_ip:10m;
limit_conn_zone $server_name zone=backup_inflight:1m;

resolver ${DNS_RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

upstream api_backend {
    zone api_backend 64k;
    least_conn;
    server api:5000 resolve;
    keepalive 32;
}

upstream receiver_backend {
    zone receiver_backend 64k;
    server receiver:5000 resolve;
    keepalive 32;
    keepalive_timeout 30s;
}

client_body_temp_path /tmp/nginx/client_temp;
proxy_temp_path /tmp/nginx/proxy_temp;
fastcgi_temp_path /tmp/nginx/fastcgi_temp;
uwsgi_temp_path /tmp/nginx/uwsgi_temp;
scgi_temp_path /tmp/nginx/scgi_temp;

client_max_body_size 64k;
client_body_timeout 10s;
client_header_timeout 10s;
client_header_buffer_size 1k;
large_client_header_buffers 2 8k;
send_timeout 30s;
keepalive_timeout 15s;
server_tokens off;

server {
    listen 8080;

    server_name default;

    include /tmp/forcad-trusted-proxies.conf;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    if ($forcad_admin_denied) {
        return 403;
    }

    location = /api/v1/client/metrics {
        return 404;
    }

    location = /api/v1/admin/metrics {
        return 404;
    }

    location = /api/v1/http-receiver/metrics {
        return 404;
    }

    location = /api/v1/events/ws {
        limit_conn board_ws_per_ip ${FORCAD_WS_PER_IP};
        limit_conn_status 429;
        error_page 429 = @api_rate_limit;
        proxy_pass http://api_backend;
        include proxy_params_ws;
        include /etc/nginx/api_limits.conf;
    }

    location ~ ^/(?:api/(?:v1/)?)?attack_data/?$ {
        rewrite ^ /api/v1/client/attack_data/ last;
    }

    location ~ ^/api/(?:v1/)?flags/?$ {
        rewrite ^ /flags/ last;
    }

    location /flags {
        limit_req zone=flags_per_ip burst=${FORCAD_FLAGS_IP_RPS} nodelay;
        limit_req zone=flags_total burst=${FORCAD_FLAGS_TOTAL_RPS} nodelay;
        limit_req_status 429;
        error_page 429 = @api_rate_limit;
        proxy_pass http://receiver_backend;
        proxy_next_upstream off;
        include proxy_params;

        client_max_body_size 10K;
        include /etc/nginx/api_limits.conf;
    }

    location = /api/v1/admin/login/ {
        limit_req zone=login_per_ip burst=5 nodelay;
        limit_req_status 429;
        error_page 429 = @api_rate_limit;

        proxy_pass http://api_backend;
        include proxy_params;
        include /etc/nginx/api_limits.conf;
    }

    location ^~ /api/v1/admin/backup/ {
        limit_conn backup_inflight 4;
        limit_conn_status 429;
        limit_req zone=api_per_ip burst=60 nodelay;
        limit_req_status 429;
        error_page 429 = @api_rate_limit;
        client_max_body_size 256m;
        client_body_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_read_timeout 610s;
        proxy_send_timeout 610s;
        proxy_next_upstream off;
        # The API verifies the session before reading the archive. Do not spool
        # an unauthenticated upload to the proxy's client-body temp directory.
        proxy_request_buffering off;
        proxy_pass http://api_backend;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        include /tmp/forcad-proxy-proto;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=60 nodelay;
        limit_req_status 429;
        error_page 429 = @api_rate_limit;

        proxy_pass http://api_backend;
        include proxy_params;
        include /etc/nginx/api_limits.conf;
    }

    location @api_rate_limit {
        add_header Retry-After "2" always;
        return 429;
    }

    location ^~ /socket.io {
        return 404;
    }

    location ^~ /team-logos/ {
        alias /var/www/front/team-logos/;
        autoindex off;
        add_header Cache-Control no-cache always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy $team_logo_csp always;
    }

    location ^~ /teams/ {
        return 404;
    }

    location / {
        include /etc/nginx/frontend_security_headers.conf;
        gzip on;
        gzip_static on;
        gzip_types text/plain text/css text/javascript application/javascript;
        gzip_disable "msie6";
        root /var/www/front;
        try_files $uri /index.html;
        autoindex off;
    }
}
