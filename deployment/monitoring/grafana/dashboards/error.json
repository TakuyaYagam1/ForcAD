  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(forcad:team_info:latest)",
          "refId": "team"
        },
        "definition": "query_result(forcad:team_info:latest)",
        "regex": "/team_id=\"(?<value>[^\"]+)\"|team_name=\"(?<text>[^\"]+)\"/g",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "component",
        "label": "Component",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(label_replace(group by (job) (up{job=~\"forcad_api|forcad_receiver|forcad_worker|forcad_ticker\"}), \"component\", \"$1\", \"job\", \"forcad_(.*)\"))",
          "refId": "component"
        },
        "definition": "query_result(label_replace(group by (job) (up{job=~\"forcad_api|forcad_receiver|forcad_worker|forcad_ticker\"}), \"component\", \"$1\", \"job\", \"forcad_(.*)\"))",
        "regex": "/component=\"(?<text>[^\"]+)\"|job=\"(?<value>[^\"]+)\"/g",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Replica",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(group by (instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\"}))",
          "refId": "instance"
        },
        "definition": "query_result(group by (instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\"}))",
        "regex": "/instance=\"([^\"]+)\"/",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
