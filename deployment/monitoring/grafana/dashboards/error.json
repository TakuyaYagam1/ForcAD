          "expr": "(sum(rate(forcad_team_http_requests_total{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\",team_id=~\"${team}\",status=~\"4..\"}[$__rate_interval]) and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1)) or (0 * sum(rate(forcad_team_http_requests_total{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\",team_id=~\"${team}\"}[$__rate_interval]) and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))))",
