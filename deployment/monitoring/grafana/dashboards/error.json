            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(100 * sum by (team_id) (rate(forcad_team_http_requests_total{status=~\"4..|5..\"}[5m])) / sum by (team_id) (rate(forcad_team_http_requests_total[5m]))) * on (team_id) group_left (team_name) max by (team_id, team_name) (forcad:team_info:latest)",
          "legendFormat": "{{team_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "title": "HTTP error ratio"
