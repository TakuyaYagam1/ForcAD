    {
      "id": 7,
      "type": "table",
      "title": "Recent HTTP errors by route - ${team:text}",
      "description": "Top 50 nonzero board error rates over five minutes, by status, route and component.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(topk(50, sum by (job, status, route) (rate(forcad_team_http_requests_total{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\",team_id=~\"${team}\",status=~\"4..|5..\"}[5m]) and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1)) > 0), \"component\", \"$1\", \"job\", \"forcad_(.*)\")",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true,
        "sortBy": [
          {
            "displayName": "Errors/s",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errors/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            },
            "indexByName": {
              "component": 0,
              "status": 1,
              "route": 2,
              "Value": 3
            },
            "renameByName": {
              "component": "Component",
              "status": "Status",
              "route": "Route",
              "Value": "Errors/s"
            }
          }
        }
      ]
