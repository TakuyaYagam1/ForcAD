  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Service checker results",
      "description": "Counts in the selected time range. A configured service with zero actions stays visible.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "checker-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "wrapText": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "checker-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS \"Service\",\n       count(e.id) FILTER (WHERE e.action = 'check') AS \"CHECK\",\n       count(e.id) FILTER (WHERE e.action = 'put') AS \"PUT\",\n       count(e.id) FILTER (WHERE e.action = 'get') AS \"GET\",\n       count(e.id) FILTER (WHERE e.status = 101) AS \"UP\",\n       count(e.id) FILTER (WHERE e.status = 102) AS \"CORRUPT\",\n       count(e.id) FILTER (WHERE e.status = 103) AS \"MUMBLE\",\n       count(e.id) FILTER (WHERE e.status = 104) AS \"DOWN\",\n       count(e.id) FILTER (WHERE e.status = 110) AS \"CHECK FAILED\",\n       count(e.id) FILTER (WHERE e.timed_out) AS \"Timeouts\",\n       max(e.time) AS \"Last run\"\nFROM checker_services AS s\nLEFT JOIN checker_action_events AS e\n  ON e.service_id = s.id\n AND $__timeFilter(e.time)\n AND e.team_id::TEXT IN (${team:sqlstring})\nWHERE s.id::TEXT IN (${service:sqlstring})\nGROUP BY s.id, s.name\nORDER BY s.name",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent checker actions",
      "description": "Persisted CHECK, PUT and GET actions for each service and team. Checker messages are withheld.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "checker-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "wrapText": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "checker-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.time AS \"Time\", e.round AS \"Round\", e.service AS \"Service\",\n       e.team AS \"Team\", upper(e.action) AS \"Action\", e.status AS \"Code\",\n       CASE e.status\n         WHEN 101 THEN 'UP' WHEN 102 THEN 'CORRUPT'\n         WHEN 103 THEN 'MUMBLE' WHEN 104 THEN 'DOWN'\n         WHEN 110 THEN 'CHECK FAILED' END AS \"Result\",\n       e.duration_ms AS \"Duration ms\", e.timed_out AS \"Timeout\"\nFROM checker_action_events AS e\nWHERE $__timeFilter(e.time)\n  AND e.service_id::TEXT IN (${service:sqlstring})\n  AND e.team_id::TEXT IN (${team:sqlstring})\nORDER BY e.time DESC, e.id DESC\nLIMIT 200",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue and running work",
      "description": "Open jobs include queued and running work. Compare with occupied action slots.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
