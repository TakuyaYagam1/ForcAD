  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(forcad:team_info:latest)",
          "refId": "team"
        },
        "definition": "query_result(forcad:team_info:latest)",
        "regex": "/team_id=\"(?<value>[^\"]+)\"|team_name=\"(?<text>[^\"]+)\"/g",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
