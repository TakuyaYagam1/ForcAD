      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (team_id) (rate(forcad_team_http_requests_total{job=~\"forcad_api|forcad_receiver\"}[1m]) and on (job, instance) (up{job=~\"forcad_api|forcad_receiver\"} == 1)) * on (team_id) group_left (team_name) max by (team_id, team_name) (forcad:team_info:latest)",
          "legendFormat": "{{team_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "type": "timeseries",
      "title": "RPS",
      "description": "Completed backend requests by team. Unknown includes unmatched source addresses. Requests rejected before reaching the backend are not included."
    },
