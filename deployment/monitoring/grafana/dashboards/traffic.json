      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(8 / 1000000 * sum by (team_ip) (rate(forcad_team_network_transmit_bytes_total[1m]) and on (job, instance) (up{job=\"forcad_router\"} == 1))) * on (team_ip) group_left (team_id) forcad:team_network_info:unique * on (team_id) group_left (team_name) max by (team_id, team_name) (forcad:team_info:latest)",
          "legendFormat": "out {{team_name}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(8 / 1000000 * sum by (team_ip) (rate(forcad_team_network_receive_bytes_total[1m]) and on (job, instance) (up{job=\"forcad_router\"} == 1))) * on (team_ip) group_left (team_id) forcad:team_network_info:unique * on (team_id) group_left (team_name) max by (team_id, team_name) (forcad:team_info:latest)",
          "legendFormat": "in {{team_name}}",
          "range": true,
          "refId": "B"
        }
      ],
      "type": "timeseries",
      "title": "Network traffic",
      "description": "Forwarded traffic through the configured router. Shared or ambiguous team addresses are excluded."
