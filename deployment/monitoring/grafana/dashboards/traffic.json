        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "team_name": 0,
              "source_ip": 1,
              "team_ip": 2,
              "Value": 3
            },
            "renameByName": {
              "team_name": "Victim team",
              "source_ip": "Source IP",
              "team_ip": "Vulnbox IP",
              "Value": "Packets/s"
