        "w": 24,
        "h": 10
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "enablePagination": false,
        "sortBy": [
          {
            "displayName": "Packets/s",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "topk(50, sum by (source_ip, team_ip) (rate(forcad_network_source_packets_total{job=\"forcad_router\"}[5m]) and on (job, instance) (forcad_network_source_scrape_success{job=\"forcad_router\"} == 1)) * on (team_ip) group_left (team_name) max by (team_ip, team_name) (forcad:team_info:latest{team_id!=\"__unknown__\"}))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "team_name": 0,
              "source_ip": 1,
              "team_ip": 2,
              "Value": 3
            },
            "renameByName": {
              "team_name": "Victim team",
              "source_ip": "Source IP",
              "team_ip": "Vulnbox IP",
              "Value": "Packets/s"
            }
          }
        }
      ],
      "type": "table",
      "title": "Top sources to vulnboxes",
      "description": "Forwarded packets by original source IP and destination vulnbox, measured on the router after filtering and before SNAT. Shows the 50 most active pairs over five minutes. Empty until the source-aware router exporter is deployed."
    }
