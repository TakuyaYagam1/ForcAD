      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(forcad_database_connections_in_use and on (job, instance) (up == 1))",
          "legendFormat": "in use",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(clamp_min(forcad_database_connections - forcad_database_connections_in_use, 0) and on (job, instance) (up == 1))",
          "legendFormat": "idle",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
