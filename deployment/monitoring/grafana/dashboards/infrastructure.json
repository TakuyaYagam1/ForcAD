    {
      "id": 7,
      "type": "table",
      "title": "Components - current pools",
      "description": "Click a component, then choose Replica. Counts sum healthy replicas; Max DB pool % uses the busiest pool. DB counts are PgBouncer clients, not PostgreSQL sessions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(sum by (component) (label_replace((sum by (job) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == bool 1)), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"Healthy\", \"__name__\", \".*\")\nor\nlabel_replace(sum by (component) (label_replace((sum by (job) (forcad_database_connections_in_use{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"DB in use\", \"__name__\", \".*\")\nor\nlabel_replace(sum by (component) (label_replace((sum by (job) (forcad_database_connections{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"DB open\", \"__name__\", \".*\")\nor\nlabel_replace(sum by (component) (label_replace((sum by (job) (forcad_database_connection_limit{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"DB capacity\", \"__name__\", \".*\")\nor\nlabel_replace(sum by (component) (label_replace((max by (job) ((100 * forcad_database_connections_in_use{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} / clamp_min(forcad_database_connection_limit{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"}, 1)) and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"Max DB pool %\", \"__name__\", \".*\")\nor\nlabel_replace(sum by (component) (label_replace((sum by (job) (forcad_redis_connections{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"Redis open\", \"__name__\", \".*\")\nor\nlabel_replace(sum by (component) (label_replace((sum by (job) (forcad_redis_connections_idle{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"Redis idle\", \"__name__\", \".*\")\nor\nlabel_replace(sum by (component) (label_replace((sum by (job) (forcad_redis_pool_pending_requests{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} and on (job, instance) (up{job=~\"forcad_(api|receiver|worker|ticker)\",job=~\"${component}\",instance=~\"${instance}\"} == 1))), \"component\", \"$1\", \"job\", \"forcad_(.*)\")), \"column\", \"Redis waiting\", \"__name__\", \".*\")",
          "refId": "A",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Max DB pool %",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "N/A",
          "custom": {
            "align": "right",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Component"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect component",
                    "url": "/d/forcad-infrastructure?var-component=forcad_${__data.fields[\"Component\"]}&var-instance=All&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max DB pool %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "column",
            "emptyValue": "null",
            "rowField": "component",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "component\\column": 0,
              "Healthy": 1,
              "DB in use": 2,
              "DB open": 3,
              "DB capacity": 4,
              "Max DB pool %": 5,
              "Redis open": 6,
              "Redis idle": 7,
              "Redis waiting": 8
            },
            "renameByName": {
              "component\\column": "Component"
            }
          }
        }
      ]
