        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(forcad_database_connection_limit and on (job, instance) (up == 1))",
          "legendFormat": "pool capacity",
          "range": true,
          "refId": "D"
        }
      ],
      "type": "timeseries",
      "title": "Application DB connections",
      "description": "Application pools: acquired, idle, total open and configured capacity across healthy replicas. These are PgBouncer client connections, not PostgreSQL server sessions."
