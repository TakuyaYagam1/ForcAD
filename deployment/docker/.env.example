# Frontend branding (public build arguments). Quote hex colors; rebuild nginx after changes.
VITE_BRAND_NAME=ForcAD
VITE_BRAND_LOGO=/brand/forcad-mark.svg
VITE_BRAND_PRIMARY="#5B8DEF"
VITE_BRAND_ACCENT="#38B7B0"

# From the repository root: cp -n deployment/docker/.env.example deployment/docker/.env
# All settings below are optional. Uncomment only the values you want to override.
# Keep .env private. ./control.sh setup writes game and storage credentials under config/runtime/.

# Public access. Set the exact browser origin (e.g. https://game.example), without a path.
# PUBLIC_ORIGIN=
# PUBLIC_SCHEME=http
# FORCAD_NGINX_BIND=0.0.0.0
# Trust only the reverse proxies that connect to ForcAD, not player networks.
# TRUSTED_PROXY_CIDRS=
# Standalone admin routes have no IP restriction until configured. The deny list wins.
# FORCAD_ADMIN_CIDR=
# FORCAD_ADMIN_DENY_CIDRS=

# Service replicas; worker concurrency is the number of checker slots per worker.
# FORCAD_WORKER_REPLICAS=4
# FORCAD_WORKER_CONCURRENCY=8
# FORCAD_API_REPLICAS=4
# FORCAD_RECEIVER_REPLICAS=2
# FORCAD_TICKER_REPLICAS=1

# Per-team flag quota: flags/second and burst size in flags, shared across receivers.
# FLAG_RATE=200
# FLAG_BURST=500
# Nginx /flags limits count HTTP requests/second, not individual flags.
# FORCAD_FLAGS_IP_RPS=400
# FORCAD_FLAGS_TOTAL_RPS=2000
# Concurrent scoreboard WebSockets per client IP
# FORCAD_WS_PER_IP=128

# Backend and checkers
# Concurrent HTTP requests per replica: API defaults to 256, receiver to 128.
# FORCAD_API_HTTP_MAX_INFLIGHT=256
# FORCAD_RECEIVER_HTTP_MAX_INFLIGHT=128
# CHECKER_JOB_GRACE=30s
# CHECKER_WORKFLOW_TIMEOUT=30m
# FORCAD_CHECKER_MEMORY_LIMIT_MB=1024
# FORCAD_CHECKER_OUTPUT_LIMIT_BYTES=1048576
# FORCAD_RUNTIME_DIR=../../config/runtime

# Container budgets. Memory reservations are soft; a hard limit of 0 means unlimited.
# FORCAD_SERVICE_PIDS=512
# FORCAD_WORKER_PIDS=2048
# FORCAD_SERVICE_MEMORY_RESERVATION=128m
# FORCAD_API_MEMORY_RESERVATION=512m
# FORCAD_RECEIVER_MEMORY_RESERVATION=512m
# FORCAD_WORKER_MEMORY_RESERVATION=768m
# FORCAD_TICKER_MEMORY_RESERVATION=128m
# FORCAD_POSTGRES_MEMORY_RESERVATION=4g
# FORCAD_PGBOUNCER_MEMORY_RESERVATION=128m
# FORCAD_REDIS_MEMORY_RESERVATION=512m
# FORCAD_NATS_MEMORY_RESERVATION=512m
# FORCAD_SERVICE_MEMORY=0
# The following role limits inherit FORCAD_SERVICE_MEMORY when unset.
# FORCAD_API_MEMORY=
# FORCAD_TICKER_MEMORY=
# FORCAD_POSTGRES_MEMORY=
# FORCAD_PGBOUNCER_MEMORY=
# FORCAD_REDIS_MEMORY=
# FORCAD_NATS_MEMORY=
# Receiver and worker limits are independent of FORCAD_SERVICE_MEMORY.
# FORCAD_RECEIVER_MEMORY=0
# FORCAD_WORKER_MEMORY=0

# Go runtime targets, not container limits
# FORCAD_API_GOGC=200
# FORCAD_API_GOMEMLIMIT=512MiB
# FORCAD_RECEIVER_GOMEMLIMIT=768MiB
# FORCAD_WORKER_GOMEMLIMIT=192MiB

# PostgreSQL and application connection pools
# FORCAD_POSTGRES_MAX_CONNECTIONS=200
# FORCAD_POSTGRES_SHARED_BUFFERS=2GB
# FORCAD_POSTGRES_SHM_SIZE=512m
# Leave the shared maximum unset to keep the per-role defaults shown below.
# DATABASE_MAX_CONNS=
# FORCAD_API_DATABASE_MAX_CONNS=16
# FORCAD_RECEIVER_DATABASE_MAX_CONNS=16
# FORCAD_WORKER_DATABASE_MAX_CONNS=4
# FORCAD_TICKER_DATABASE_MAX_CONNS=8
# The API minimum follows its effective maximum unless overridden.
# FORCAD_API_DATABASE_MIN_CONNS=

# PgBouncer: total clients and per-role server connections
# PGBOUNCER_MAX_CLIENTS=1024
# PGBOUNCER_API_CONNECTIONS=32
# The API minimum follows PGBOUNCER_API_CONNECTIONS unless overridden.
# PGBOUNCER_API_MIN_CONNECTIONS=
# PGBOUNCER_RECEIVER_CONNECTIONS=64
# PGBOUNCER_WORKER_CONNECTIONS=32
# PGBOUNCER_TICKER_CONNECTIONS=8
# Leave per-role client limits unset to calculate them from replicas and pool sizes.
# PGBOUNCER_API_CLIENTS=
# PGBOUNCER_RECEIVER_CLIENTS=
# PGBOUNCER_WORKER_CLIENTS=
# PGBOUNCER_TICKER_CLIENTS=

# NATS JetStream: ticker and workers must use the same stream, subject and consumer.
# NATS_STREAM=FORCAD_CHECKERS
# NATS_SUBJECT=forcad.checker.jobs
# NATS_CONSUMER=forcad-workers
# NATS_MAX_ACK_PENDING=1024

# Monitoring overlay only. Supply two separate secrets before starting it.
# Grafana reads the admin password on first initialization. For the checker DB reader,
# generate a lowercase hex password of at least 32 characters (openssl rand -hex 32).
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_CHECKER_DB_PASSWORD=
# GRAFANA_CHECKER_DB_NAME=forcad
# Image used to provision the checker DB reader
# FORCAD_POSTGRES_IMAGE=forcad_postgres:local
# FORCAD_GRAFANA_PORT=3000
# FORCAD_PROMETHEUS_PORT=9090
# FORCAD_GRAFANA_MEMORY_RESERVATION=512m
# FORCAD_GRAFANA_MEMORY=0
# FORCAD_PROMETHEUS_MEMORY_RESERVATION=2g
# FORCAD_PROMETHEUS_MEMORY=0
# FORCAD_PROMETHEUS_RETENTION_TIME=7d
# FORCAD_PROMETHEUS_RETENTION_SIZE=16GB
# FORCAD_PROMETHEUS_QUERY_CONCURRENCY=8
# FORCAD_PROMETHEUS_QUERY_SAMPLES=5000000

# Database TLS overlay only: absolute host directory containing ca.crt, pooler.crt and pooler.key.
# FORCAD_DB_TLS_DIR=
