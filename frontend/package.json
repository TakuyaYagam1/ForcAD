{
  "name": "front-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "generate:api": "node ../api/scripts/generate.mjs frontend",
    "build": "tsc -b && vite build",
    "lint": "eslint . && cd ../api && node ../frontend/node_modules/eslint/bin/eslint.js scripts",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "pnpm typecheck:e2e && playwright test",
    "typecheck:e2e": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --target ES2022 --module ESNext --moduleResolution Bundler --types node playwright.config.ts e2e/*.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.107.1",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "27.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hookform/resolvers": "7.0.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "orval": "8.47.0",
    "react-hook-form": "7.92.0",
    "sass-embedded": "1.108.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.11.2"
}
