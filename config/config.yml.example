game:
  mode: classic
  round_time: 60
  rounds: 300
  start_time: "2027-01-01 12:00:00"
  timezone: Europe/Moscow
  default_score: 2500
  flag_lifetime: 5
  game_hardness: 10.0
  inflation: true
  volga_attacks_mode: false
  # Host checkers/ is mounted here; keep unchanged with the supplied Compose setup.
  checkers_path: /checkers/
  # Python executables built into the worker image; keep unchanged with the supplied Dockerfile.
  env_path: /opt/checkers/bin
  # CHECK/GET interval in seconds; used only in blitz mode.
  # get_period: 60

tasks:
  - name: example_service
    checker: examples/note/checker.py
    checker_timeout: 10
    checker_type: hackerdom
    puts: 2
    gets: 2
    places: 2
    default_score: 2500
    # Task-specific CHECK/GET interval in seconds; blitz only.
    # get_period: 60

teams:
  - name: danosito's ai farm
    ip: 192.168.1.2
    highlighted: false
    logo_path: "/team-logos/danosito.jpg"
    token: null
    traffic_cidrs:
      - 192.168.1.2/32
      - 10.200.0.2/32

  - name: pod egidoy
    ip: 192.168.1.3
    highlighted: true
    logo_path: "/team-logos/egida.png"
    token: null
    traffic_cidrs:
      - 192.168.1.3/32
      - 10.200.0.3/32
