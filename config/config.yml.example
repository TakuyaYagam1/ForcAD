# Чемпионат России. Скопируйте в config.yml и замените TEST-NET адреса на адреса vulnbox.
# Выдайте командам приватные токены и впишите их вместо null только в локальный config.yml.
game:
    mode: classic
    round_time: 60
    extra_checks: 0
    rounds: 240
    start_time: "2027-12-31 23:59:59"
    timezone: Europe/Moscow
    default_score: 2500
    flag_lifetime: 5
    game_hardness: 10
    inflation: true
    volga_attacks_mode: false
    checkers_path: /checkers/
    env_path: /opt/checkers/bin
    get_period: null
tasks:
    - name: kincare
      checker: /checkers/kincare/checker.py
      checker_type: pfr
      checker_timeout: 15
      puts: 5
      gets: 3
      places: 5
      env_path: /opt/checkers/bin
      default_score: 2500
      get_period: 60
    - name: wahrwelt
      checker: /checkers/wahrwelt/checker.py
      checker_type: pfr
      checker_timeout: 20
      puts: 10
      gets: 1
      places: 10
      env_path: /opt/checkers/bin
      default_score: 2500
      get_period: 60
    - name: sentinel
      checker: /checkers/sentinel/checker.py
      checker_type: pfr
      checker_timeout: 15
      puts: 3
      gets: 3
      places: 3
      env_path: /opt/checkers/bin
      default_score: 2500
      get_period: 60
